.custom-confirm-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:5000}.custom-confirm-dialog{background:#fff;border-radius:12px;width:80%;max-width:320px;overflow:hidden}.custom-confirm__title{display:block;font-size:16px;font-weight:600;color:#1e293b;padding:16px 16px 8px;text-align:center}.custom-confirm__body{padding:0 16px 16px}.custom-confirm__content{display:block;font-size:13px;color:#6b7280;line-height:1.6}.custom-confirm__input{display:block;width:100%;margin-top:12px;height:40px;padding:0 12px;font-size:14px;color:#1e293b;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;box-sizing:border-box}.custom-confirm__footer{display:flex;border-top:1px solid #f3f4f6}.custom-confirm__btn{flex:1;text-align:center;padding:13px 0;font-size:15px;border-left:1px solid #f3f4f6}.custom-confirm__btn--confirm{color:#00afff;font-weight:500}.custom-confirm__btn--danger{color:#dc2626;font-weight:500}.custom-confirm__btn--cancel{color:#6b7280}.dark-mode .custom-confirm-dialog{background:#374151}.dark-mode .custom-confirm__title{color:#f0f0f0}.dark-mode .custom-confirm__content{color:#9ca3af}.dark-mode .custom-confirm__input{color:#f0f0f0;background:#2d3748;border-color:#4b5563}.dark-mode .custom-confirm__footer{border-top-color:#4b5563}.dark-mode .custom-confirm__btn--confirm{color:#60a5fa}.dark-mode .custom-confirm__btn--danger{color:#f87171}.dark-mode .custom-confirm__btn--cancel{color:#9ca3af}.dark-mode .custom-confirm__btn{border-left-color:#4b5563}.custom-confirm__footer--vertical{flex-direction:column}.custom-confirm__footer--vertical .custom-confirm__btn{display:block;width:100%;border-left:0}.custom-confirm__footer--vertical .custom-confirm__btn:first-child{border-top:1px solid #f3f4f6}.dark-mode .custom-confirm__footer--vertical .custom-confirm__btn:first-child{border-top-color:#4b5563}
