  box-shadow: 0 0 30px rgba(0, 175, 255, 0.5), 0 0 60px rgba(0, 215, 205, 0.25);
  animation: orb-pulse-f073899c 1.6s ease-in-out infinite;
  z-index: 2;
}
@keyframes orb-pulse-f073899c {
0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 30px rgba(0, 175, 255, 0.5), 0 0 60px rgba(0, 215, 205, 0.25);
}
50% {
    transform: scale(1.1);
    box-shadow: 0 0 40px rgba(0, 175, 255, 0.7), 0 0 80px rgba(0, 215, 205, 0.4);
}
}
/* 球体内波形条 */
.pulse-bars.data-v-f073899c {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  height: 28px;
