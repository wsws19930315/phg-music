.pulse-bar.data-v-f073899c {
  flex: 1;
  min-width: 2px;
  max-width: 4px;
  background: #ffffff;
  border-radius: 2px;
  transition: height 0.1s ease;
}

/* 涟漪环 */
.pulse-ring.data-v-f073899c {
  position: absolute;
  border-radius: 50%;
  border: 2px solid rgba(0, 175, 255, 0.5);
  animation: pulse-expand-f073899c 2.4s ease-out infinite;
}
.r1.data-v-f073899c {
  animation-delay: 0s;
}
.r2.data-v-f073899c {
  animation-delay: 0.8s;
}
.r3.data-v-f073899c {
  animation-delay: 1.6s;
}
@keyframes pulse-expand-f073899c {
0% {
    width: 64px;
    height: 64px;
    opacity: 0.7;
    border-color: rgba(0, 215, 205, 0.6);
}
100% {
    width: 180px;
    height: 180px;
    opacity: 0;
    border-color: rgba(0, 175, 255, 0.05);
}
}
