/* ===== 空闲状态 ===== */
.mic-circle.data-v-f073899c {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d7cd 0%, #00afff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30px;
  box-shadow: 0 8px 32px rgba(0, 175, 255, 0.35);
  position: relative;
  transition: transform 0.2s;
}
.mic-circle.data-v-f073899c:active {
  transform: scale(0.92);
}
.mic-circle-pulse.data-v-f073899c::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d7cd 0%, #00afff 100%);
  animation: mic-pulse-f073899c 2s ease-out infinite;
  z-index: -1;
}
@keyframes mic-pulse-f073899c {
0% {
    transform: scale(1);
    opacity: 0.6;
}
100% {
    transform: scale(1.6);
    opacity: 0;
}
}
.mic-circle-inner.data-v-f073899c {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 统一脉冲动画（录音 + 识别共用） ===== */
